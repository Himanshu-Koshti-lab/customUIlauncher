<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metro_background"
    android:orientation="vertical">

    <!-- Header: time-zone picker + 24h clock on the left, options menu on the top right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/zone_select"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/select_time_zone"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:maxWidth="150dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="42sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/options"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/options"
            android:scaleType="center"
            android:src="@drawable/ic_options" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/start_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/empty_start"
            android:textColor="@color/metro_text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- "#" + letters fast-scroll index (only characters that have apps). Always shown; touching it reveals
             the app list. Sits in the list's end padding. -->
        <com.example.customuilauncher.AlphabetScrollBar
            android:id="@+id/alphabet_bar"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Large preview of the character under the finger while dragging the index. -->
        <TextView
            android:id="@+id/section_preview"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@color/metro_accent"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
